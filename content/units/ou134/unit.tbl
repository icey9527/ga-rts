; ============================================================
; ou134 —— 目录名即 ID，这里不重复声明 id
; 示例单位，用于把 TBL 格式与校验链跑通
;
; 机动数值口径（docs/scale-and-units.md）：
;   船长 351.7 m（重巡，主力舰量级 120~400 m）
;   speed 180 m/s → acceleration 70 = 2.6 s 到巡航；deceleration 55 = 3.3 s 收住（大船难刹）
;   turn_rate_yaw 12 °/s（180° 掉头 15 s，转弯半径 = v/ω = 180 / 0.209 ≈ 859 m ≈ 2.4 倍船长）
;   radius 176 m ≈ 船长一半（寻路膨胀用）—— 大船要绕得更开，这是刻意的
;   cruise_altitude 0：重巡压在本层中心（带内 +-150，ADR-0003）
; ============================================================

[stats]
name      = "Ou134 重巡洋舰"
speed     = 180.0
max_hp    = 12800
armor     = 40
shield    = 5200
radar     = 3600.0
cost      = 340

; ─── 机动（改数值前先看文件头的推导）─────────────────────────────
acceleration    = 70.0      ; m/s^2
deceleration    = 55.0      ; m/s^2
turn_rate_yaw   = 12.0      ; 度/秒
turn_rate_pitch = 6.0       ; 度/秒
radius          = 176.0     ; 米（船长 351.7 的一半）
cruise_altitude = 0.0       ; 米，相对本层中心；±150 带内

[assets]
model     = ou134

[weapon]
main      = heavy_beam
count:int = 4
spread:vec3 = 0,4.5,0
