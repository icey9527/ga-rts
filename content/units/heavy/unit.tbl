; ============================================================
; 重型护卫舰（heavy）
;
; 舰队抗线核心。慢但可靠，四门重炮压制中距离。
;
; radius 来自 GLB 包围盒实测（ou134 最长边 351.74 m ÷ 2），
; **不要手改** —— 寻路膨胀 / 单位分离 / 扫掠命中都吃这个值。
; model 是逻辑名，解析走 content/assets/assets.tbl 的 [ship] 段；换模型只改那一行。
; ============================================================
[stats]
name      = "重型护卫舰"
speed     = 180
max_hp    = 12800
armor     = 64
shield    = 4480
radar     = 2527
cost      = 426
acceleration    = 90.0
deceleration    = 108.0
turn_rate_yaw   = 12
turn_rate_pitch = 6
radius          = 175.87
cruise_altitude = 0

[assets]
model     = ou134

[weapon]
main        = heavy_beam
count:int   = 4
spread:vec3 = 0,4.5,0

; 战斗行为（T-4.2）：接近目标后怎么走位。不写就默认 close_in。
;   close_in / standoff / orbit / strafe
[behavior]
kind        = close_in

; 角色头像（S5 立绘迁移）：图在 assets/ui/faces/<chara>.png，
; 由 assets.tbl 的 [face] 段解析。空 = 没有头像，表现层回退到机型缩写。
; **必须加引号**：不加引号 TBL 会当数字解，042 会变成 42、前导零丢失。
[portrait]
chara       = "038"
