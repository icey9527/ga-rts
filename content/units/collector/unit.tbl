; ============================================================
; 资源采集站（collector）
;
; 几乎不动的后方设施。火力仅够自卫。
;
; radius 来自 GLB 包围盒实测（ou137 最长边 200.88 m ÷ 2），
; **不要手改** —— 寻路膨胀 / 单位分离 / 扫掠命中都吃这个值。
; model 是逻辑名，解析走 content/assets/assets.tbl 的 [ship] 段；换模型只改那一行。
; ============================================================
[stats]
name      = "资源采集站"
speed     = 60
max_hp    = 8000
armor     = 40
shield    = 2800
radar     = 2301
cost      = 266
acceleration    = 30.0
deceleration    = 36.0
turn_rate_yaw   = 10
turn_rate_pitch = 7
radius          = 100.44
cruise_altitude = 0

[assets]
model     = ou137

[weapon]
main        = machine_gun
count:int   = 1
spread:vec3 = 0,0,0

; 战斗行为（T-4.2）：接近目标后怎么走位。不写就默认 close_in。
;   close_in / standoff / orbit / strafe
[behavior]
kind        = close_in

; 角色头像（S5 立绘迁移）：图在 assets/ui/faces/<chara>.png，
; 由 assets.tbl 的 [face] 段解析。空 = 没有头像，表现层回退到机型缩写。
; **必须加引号**：不加引号 TBL 会当数字解，042 会变成 42、前导零丢失。
[portrait]
chara       = "035"
