; ============================================================
; ou05 —— 目录名即 ID，这里不重复声明 id
; 示例单位，用于把 TBL 格式与校验链跑通
;
; 机动数值口径（docs/scale-and-units.md）：
;   船长 63.6 m（护卫舰 / 中型舰 30~80 m 量级）
;   speed 320 m/s → acceleration 160 = 2.0 s 到巡航；deceleration 200 = 1.6 s 收住
;   turn_rate_yaw 30 °/s（180° 掉头 6 s，转弯半径 = v/ω = 320 / 0.524 ≈ 610 m ≈ 9.6 倍船长）
;   radius 32 m ≈ 船长一半（寻路膨胀用）
;   cruise_altitude +80 m：轻舰偏好骑在层带高处（±150 带内，ADR-0003）
; ============================================================

[stats]
name      = "Ou05 突击舰"
speed     = 320.0
max_hp    = 4200
armor     = 12
shield    = 1500
radar     = 2600.0
cost      = 120

; ─── 机动（改数值前先看文件头的推导）─────────────────────────────
acceleration    = 160.0     ; m/s^2
deceleration    = 200.0     ; m/s^2
turn_rate_yaw   = 30.0      ; 度/秒
turn_rate_pitch = 20.0      ; 度/秒
radius          = 32.0      ; 米（船长 63.6 的一半）
cruise_altitude = 80.0      ; 米，相对本层中心；±150 带内

[assets]
model     = ou05

[weapon]
; main = content/weapons/<id>/ 的目录名（T-2.2 起由 UnitWeapons.build 装配炮塔）
; count = 炮塔数；spread = 相邻炮塔在舰体坐标系里的错开量（米，vec3）
main        = pulse_cannon
count:int   = 2
spread:vec3 = 3,0,0
range       = 1800.0
