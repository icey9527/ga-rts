; ============================================================
; 指挥母舰（mothership）
;
; 战场核心。六门重炮，全场最高的血量与体积。
;
; radius 来自 GLB 包围盒实测（ou241 最长边 1123.52 m ÷ 2），
; **不要手改** —— 寻路膨胀 / 单位分离 / 扫掠命中都吃这个值。
; model 是逻辑名，解析走 content/assets/assets.tbl 的 [ship] 段；换模型只改那一行。
; ============================================================
[stats]
name      = "指挥母舰"
speed     = 90
max_hp    = 26000
armor     = 80
shield    = 9100
radar     = 3685
cost      = 866
acceleration    = 45.0
deceleration    = 54.0
turn_rate_yaw   = 4
turn_rate_pitch = 3
radius          = 561.76
cruise_altitude = 0

[assets]
model     = ou241

[weapon]
main        = heavy_beam
count:int   = 6
spread:vec3 = 0,30,0

; 战斗行为（T-4.2）：接近目标后怎么走位。不写就默认 close_in。
;   close_in / standoff / orbit / strafe
[behavior]
kind        = standoff

; 角色头像（S5 立绘迁移）：图在 assets/ui/faces/<chara>.png，
; 由 assets.tbl 的 [face] 段解析。空 = 没有头像，表现层回退到机型缩写。
; **必须加引号**：不加引号 TBL 会当数字解，042 会变成 42、前导零丢失。
[portrait]
chara       = "040"
