; ============================================================
; pulse_cannon —— 突击舰副炮（ou05 用）。低伤害 / 快射速 / 近射程。
;
; 射程只有 700 m（远小于 2000 m 上限）：快炮是近身自卫武器，
; 要打远处的目标得靠舰体推进 —— 与 ou05 的高机动（320 m/s）配套。
; cooldown 0.25 s → 单炮塔 DPS = 180；ou05 有 2 个炮塔 = 360。
; tracking_rate 90 °/s：快炮要跟得住掠过的小目标，容差也放宽到 8°。
; ============================================================

[weapon]
name             = "脉冲炮"
damage           = 45.0
range            = 700.0         ; 米
cooldown         = 0.25          ; 秒
projectile_speed = 2200.0        ; m/s
tracking_rate    = 90.0          ; 度/秒
aim_tolerance    = 8.0           ; 度
