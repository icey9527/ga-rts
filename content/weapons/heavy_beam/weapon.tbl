; ============================================================
; heavy_beam —— 重巡主炮（ou134 用）。高伤害 / 慢射速 / 远射程。
;
; 口径（docs/scale-and-units.md）：交战距离 500 m ~ 2 km。
; 重炮架在射程上限 = 2000 m；炮塔转速慢（20 °/s，转 90° 要 4.5 s），
; 因此打高速小目标要靠舰体先摆位 —— 这是重巡的设计意图，不是缺陷。
; cooldown 3.2 s → 单炮塔 DPS ≈ 131；ou134 有 4 个炮塔 ≈ 525。
; ============================================================

[weapon]
name             = "重型光束炮"
damage           = 420.0
range            = 2000.0        ; 米
cooldown         = 3.2           ; 秒（开火后到下一次可开火）
projectile_speed = 1600.0        ; m/s（T-2.3 弹体用）
tracking_rate    = 20.0          ; 度/秒（炮塔转速上限）
aim_tolerance    = 3.0           ; 度（夹角进入这个范围才能开火）
