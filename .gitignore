# ---------- Godot 4 ----------
.godot/
/android/
/export/
/build/
/dist/
export_presets.cfg
*.translation

# ---------- 导出产物 ----------
*.exe
*.pck
*.zip

# ---------- 原始模型素材库（不入库，见 docs/model-pipeline.md） ----------
# F:/godot/model 是只读素材源，仓库里只保留转换产物 assets/models/*.glb
/model/
/model-source/
/assets/models/_raw/

# ---------- 工具 / 编辑器 ----------
.vscode/
.idea/
*.tmp
*.log
Thumbs.db
desktop.ini
.DS_Store

# ---------- PI 助手会话历史 ----------
.pi/

# ---------- 本地临时 ----------
# 临时脚本目录（见 docs/tooling.md，不入库、随手删）
/tools/temp/
/tools/model-pipeline/inventory-*.csv
!/tools/model-pipeline/inventory-manifest.json

# tools/ 已用 .gdignore 屏蔽，此处兜底
*.csv.import

# 预览渲染产物（开发期检查用，可随时重跑）
/tools/pipeline/model-pipeline/preview/

# 特效管线中转出来的带 alpha 贴图（已内嵌进 glb，不必入库）
/tools/pipeline/model-pipeline/.effects_tex/

# Godot 导入 glb 时从内嵌贴图解出的同目录 png（可从 glb 再生，不入库）
/assets/models/**/*.png
/assets/models/**/*.png.import

# Python 字节码缓存（迁移脚本跑过就会生成）
__pycache__/
*.pyc
